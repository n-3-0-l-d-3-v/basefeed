# Supabase (local values: `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app (used in the embed snippet and widget tokens)
APP_URL=http://localhost:3000

# Long random strings
WIDGET_TOKEN_SECRET=
CRON_SECRET=

# AI triage (optional; comments work without it)
# anthropic | gemini | none. AI_MODEL overrides the default (claude-opus-5-5 / gemini-3.8-flash).
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=
GEMINI_API_KEY=

# Email notifications: Resend in production; Supabase's Mailpit locally
RESEND_API_KEY=
EMAIL_FROM=Basenine Feedback <onboarding@resend.dev>
MAILPIT_URL=http://127.0.0.1:56324
